{
  "name": "@trace-ux/tracker",
  "version": "0.2.11",
  "description": "TraceUX session replay, logs, events, and optional in-product widget for HTML, GTM, npm, and React",
  "keywords": [
    "session-replay",
    "rrweb",
    "analytics",
    "product-analytics",
    "session-recording",
    "feedback",
    "support-tickets",
    "self-hosted"
  ],
  "homepage": "https://trace-ux.builtbyfrank.dev/",
  "bugs": {
    "url": "https://github.com/fjosue4/trace-ux/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjosue4/trace-ux.git",
    "directory": "tracker"
  },
  "author": "fjosue4 (https://github.com/fjosue4)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "./dist/tracker.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/types/main.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./widget": {
      "types": "./dist/types/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs",
      "default": "./dist/widget.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:snippet && npm run build:esm && npm run build:cjs && npm run build:widget && npm run build:react && npm run build:types",
    "build:snippet": "esbuild src/snippet.ts --bundle --minify --format=iife --target=es2018 --legal-comments=none --loader:.mp3=dataurl --outfile=dist/tracker.js",
    "build:esm": "esbuild src/main.ts --bundle --minify --format=esm --platform=browser --target=es2018 --legal-comments=none --loader:.mp3=dataurl --external:./widget.js --outfile=dist/index.js",
    "build:cjs": "esbuild src/main.ts --bundle --minify --format=cjs --platform=browser --target=es2018 --legal-comments=none --loader:.mp3=dataurl --external:./widget.js --outfile=dist/index.cjs",
    "build:widget": "esbuild src/widget.ts --bundle --minify --format=esm --platform=browser --target=es2018 --legal-comments=none --loader:.mp3=dataurl --outfile=dist/widget.js && esbuild src/widget.ts --bundle --minify --format=cjs --platform=browser --target=es2018 --legal-comments=none --loader:.mp3=dataurl --outfile=dist/widget.cjs",
    "build:react": "esbuild src/react.ts --bundle --minify --format=esm --platform=browser --target=es2018 --legal-comments=none --external:react --external:@trace-ux/tracker --outfile=dist/react.js && esbuild src/react.ts --bundle --minify --format=cjs --platform=browser --target=es2018 --legal-comments=none --external:react --external:@trace-ux/tracker --outfile=dist/react.cjs",
    "build:types": "tsc --noEmit false --emitDeclarationOnly --declaration --declarationDir dist/types",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.1",
    "dompurify": "^3.4.16",
    "marked": "^15.0.12",
    "motion": "^13.2.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
